[Unit]
Description=Zhuzhuan website
After=network.target
[Service]
User=zhuzhuan
Group=zhuzhuan
WorkingDirectory=/opt/zhuzhuan/app
EnvironmentFile=/etc/zhuzhuan.env
ExecStart=/usr/bin/node server/main.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhuzhuan
[Install]
WantedBy=multi-user.target
